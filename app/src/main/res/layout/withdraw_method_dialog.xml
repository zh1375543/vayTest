<?xml version="1.0" encoding="utf-8"?>
<com.vaycore.finance.ui.views.StyledLinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="@dimen/dp_24"
    android:paddingTop="@dimen/dp_32"
    android:paddingBottom="@dimen/dp_24"
    app:radius="@dimen/dp_24"
    app:solidColor="@color/text_inverse">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="@string/select_withdraw_method"
        android:textColor="@color/text_primary"
        android:textSize="@dimen/sp_20"
        android:textStyle="bold" />

    <com.vaycore.finance.ui.views.StyledLinearLayout
        android:id="@+id/eWalletOptionView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_28"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/dp_16"
        android:paddingVertical="@dimen/dp_15"
        app:radius="@dimen/dp_24"
        app:solidColor="@color/surface_secondary">

        <ImageView
            android:layout_width="@dimen/dp_36"
            android:layout_height="@dimen/dp_36"
            android:contentDescription="@null"
            android:src="@mipmap/ic_wallet_select_bg" />

        <LinearLayout
            android:layout_width="@dimen/dp_0"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/dp_12"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/e_wallet"
                android:textColor="@color/text_body"
                android:textSize="@dimen/sp_18" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_8"
                android:orientation="horizontal">

                <com.vaycore.finance.ui.views.StyledTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingVertical="@dimen/dp_3"
                    android:paddingHorizontal="@dimen/dp_10"
                    android:gravity="center"
                    android:text="@string/gcash"
                    android:textColor="@color/text_inverse"
                    android:textSize="@dimen/sp_12"
                    app:radius="@dimen/dp_14"
                    app:solidColor="@color/brand_primary" />

                <com.vaycore.finance.ui.views.StyledTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/dp_5"
                    android:paddingVertical="@dimen/dp_3"
                    android:paddingHorizontal="@dimen/dp_10"
                    android:gravity="center"
                    android:text="@string/payso"
                    android:textColor="@color/text_inverse"
                    android:textSize="@dimen/sp_12"
                    app:radius="@dimen/dp_14"
                    app:solidColor="@color/brand_primary" />
                <com.vaycore.finance.ui.views.StyledTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/dp_5"
                    android:paddingVertical="@dimen/dp_3"
                    android:paddingHorizontal="@dimen/dp_10"
                    android:gravity="center"
                    android:text="@string/more"
                    android:textColor="@color/text_inverse"
                    android:textSize="@dimen/sp_12"
                    app:radius="@dimen/dp_14"
                    app:solidColor="@color/brand_primary" />


            </LinearLayout>
        </LinearLayout>

        <ImageView
            android:layout_width="@dimen/dp_24"
            android:layout_height="@dimen/dp_24"
            android:contentDescription="@null"
            android:src="@mipmap/mine_right" />
    </com.vaycore.finance.ui.views.StyledLinearLayout>

    <com.vaycore.finance.ui.views.StyledLinearLayout
        android:id="@+id/bankOptionView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_15"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/dp_16"
        android:paddingVertical="@dimen/dp_15"
        app:radius="@dimen/dp_24"
        app:solidColor="@color/surface_secondary">

        <ImageView
            android:layout_width="@dimen/dp_36"
            android:layout_height="@dimen/dp_36"
            android:contentDescription="@null"
            android:src="@mipmap/ic_bank_select_bg" />

        <LinearLayout
            android:layout_width="@dimen/dp_0"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/dp_12"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/bank"
                    android:textColor="@color/text_body"
                    android:textSize="@dimen/sp_18" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/dp_12"
                    android:drawableEnd="@mipmap/ic_bank_state"
                    android:drawablePadding="@dimen/dp_4"
                    android:gravity="center_vertical"
                    android:text="@string/higher_credit_limit"
                    android:textColor="@color/brand_primary"
                    android:textSize="@dimen/sp_12" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_10"
                android:text="@string/all_major_banks"
                android:textColor="@color/text_tertiary"
                android:textSize="@dimen/sp_12" />
        </LinearLayout>

        <ImageView
            android:layout_width="@dimen/dp_24"
            android:layout_height="@dimen/dp_24"
            android:contentDescription="@null"
            android:src="@mipmap/mine_right" />
    </com.vaycore.finance.ui.views.StyledLinearLayout>

    <com.vaycore.finance.ui.views.StatefulActionButton
        android:id="@+id/cancelView"
        android:layout_width="@dimen/dp_160"
        android:layout_height="@dimen/dp_48"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="@dimen/dp_20"
        android:gravity="center"
        android:text="@string/cancel"
        android:textColor="@color/brand_primary"
        android:textSize="@dimen/sp_18"
        app:actionButtonVariant="outline"
        android:textStyle="bold" />
</com.vaycore.finance.ui.views.StyledLinearLayout>
