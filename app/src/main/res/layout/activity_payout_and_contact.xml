<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <import type="android.view.View" />

        <variable
            name="isCertified"
            type="Boolean" />

        <variable
            name="showBankFields"
            type="Boolean" />

        <variable
            name="showWalletFields"
            type="Boolean" />
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@mipmap/ic_page_bg">

    <com.vaycore.finance.ui.views.PageHeaderView
        android:id="@+id/titleBar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_44"
        app:centerText="@string/bank_and_contact"
        app:layout_constraintTop_toTopOf="parent" />

    <com.vaycore.finance.ui.views.ContentStateLayout
        android:id="@+id/loading_layout"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginBottom="@dimen/dp_15"
        android:paddingTop="@dimen/dp_10"
        app:layout_constraintBottom_toTopOf="@id/bottomActionLayout"
        app:layout_constraintTop_toBottomOf="@id/titleBar">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <androidx.core.widget.NestedScrollView
                android:id="@+id/scrollView"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp_0"
                android:layout_weight="1"
                android:clipToPadding="false"
                android:fillViewport="true"
                android:overScrollMode="never"
                android:paddingBottom="@dimen/dp_24">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/dp_16"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/confirm_layout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="@{!isCertified ? View.VISIBLE : View.GONE}"
                    tools:visibility="visible">
                    <include
                        android:id="@+id/withdrawAccountForm"
                        layout="@layout/view_withdraw_account_form"
                        app:isCertified="@{isCertified}"
                        app:showBankFields="@{showBankFields}"
                        app:showWalletFields="@{showWalletFields}" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_24"
                    android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:text="@string/contact_info"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/sp_18"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvContactTips"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_10"
                    android:text="@string/contact_tips"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/sp_12"
                    android:visibility="@{!isCertified ? View.VISIBLE : View.GONE}" />

                <com.vaycore.finance.ui.views.StyledLinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_12"
                    android:orientation="vertical"
                    app:radius="@dimen/dp_12"
                    app:solidColor="@color/text_inverse">

                <!-- Relationship 1 -->
                <com.vaycore.finance.ui.views.FormItemView
                    android:id="@+id/relativesView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:errorText="@string/please_choose_current_info"
                    app:formType="select"
                    app:hintText="@string/please_choose"
                    app:editable="@{!isCertified}"
                    app:titleText="@string/contact_people1" />

                <!-- Contact name -->
                <com.vaycore.finance.ui.views.FormItemView
                    android:id="@+id/relativesNameView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:errorText="@string/please_enter_contact_name"
                    app:formType="input"
                    app:hintText="@string/please_enter_contact_name"
                    app:inputType="text"
                    app:editable="@{!isCertified}"
                    app:titleText="@string/contact_name" />

                <!-- Contact phone -->
                <com.vaycore.finance.ui.views.FormItemView
                    android:id="@+id/relativesPhoneView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:editMaxLength="40"
                    app:errorText="@string/please_enter_phone_number"
                    app:formType="input"
                    app:hintText="@string/please_enter_phone_number"
                    app:inputType="phone"
                    app:showContactIcon="true"
                    app:contactPickerVisible="@{!isCertified}"
                    app:editable="@{!isCertified}"
                    app:titleText="@string/contact_phone_number" />

                <com.vaycore.finance.ui.views.FormItemView
                    android:id="@+id/friendView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:errorText="@string/please_choose_current_info"
                    app:formType="select"
                    app:hintText="@string/please_choose"
                    app:editable="@{!isCertified}"
                    app:titleText="@string/contact_people2" />

                <com.vaycore.finance.ui.views.FormItemView
                    android:id="@+id/friendNameView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:errorText="@string/please_enter_contact_name"
                    app:formType="input"
                    app:hintText="@string/please_enter_contact_name"
                    app:inputType="text"
                    app:editable="@{!isCertified}"
                    app:titleText="@string/contact_name" />

                <com.vaycore.finance.ui.views.FormItemView
                    android:id="@+id/friendPhoneView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:editMaxLength="40"
                    app:errorText="@string/please_enter_phone_number"
                    app:formType="input"
                    app:hintText="@string/please_enter_phone_number"
                    app:inputType="phone"
                    app:showContactIcon="true"
                    app:contactPickerVisible="@{!isCertified}"
                    app:editable="@{!isCertified}"
                    app:titleText="@string/contact_phone_number" />

                <LinearLayout
                    android:id="@+id/additionalContactContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <com.vaycore.finance.ui.views.FormItemView
                        android:id="@+id/additionalContactRelationshipView"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:errorText="@string/please_choose_current_info"
                        app:formType="select"
                        app:hintText="@string/please_choose"
                        app:editable="@{!isCertified}"
                        app:titleText="@string/contact_people3" />

                    <com.vaycore.finance.ui.views.FormItemView
                        android:id="@+id/additionalContactNameView"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:errorText="@string/please_enter_contact_name"
                        app:formType="input"
                        app:hintText="@string/please_enter_contact_name"
                        app:inputType="text"
                        app:editable="@{!isCertified}"
                        app:titleText="@string/contact_name" />

                    <com.vaycore.finance.ui.views.FormItemView
                        android:id="@+id/additionalContactPhoneView"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:editMaxLength="40"
                        app:errorText="@string/please_enter_phone_number"
                        app:formType="input"
                        app:hintText="@string/please_enter_phone_number"
                        app:inputType="phone"
                        app:showContactIcon="true"
                        app:contactPickerVisible="@{!isCertified}"
                        app:editable="@{!isCertified}"
                        app:titleText="@string/contact_phone_number" />
                </LinearLayout>

                <Space
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dp_18" />
                </com.vaycore.finance.ui.views.StyledLinearLayout>
                </LinearLayout>
            </LinearLayout>
            </androidx.core.widget.NestedScrollView>
        </LinearLayout>

    </com.vaycore.finance.ui.views.ContentStateLayout>

    <LinearLayout
        android:id="@+id/bottomActionLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/dp_15"
        android:orientation="vertical"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        tools:visibility="visible">

        <TextView
            style="@style/AuthDataEncryptedTipText"
            android:layout_gravity="center_horizontal"
            android:layout_marginHorizontal="@dimen/dp_16"
            android:layout_marginBottom="@dimen/dp_10" />

        <com.vaycore.finance.ui.views.StatefulActionButton
            android:id="@+id/btNext"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_48"
            android:layout_marginHorizontal="@dimen/dp_16"
            android:text="@string/next"
            app:actionButtonVariant="filled" />
    </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>
