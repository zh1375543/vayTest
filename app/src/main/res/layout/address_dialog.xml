<?xml version="1.0" encoding="utf-8"?>
<com.vaycore.finance.ui.views.StyledConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:left_top_radius="@dimen/dp_20"
    app:right_top_radius="@dimen/dp_20"
    app:solidColor="@color/text_inverse">

    <TextView
        android:id="@+id/tvProvince"
        android:layout_width="0dp"
        android:layout_height="@dimen/dp_44"
        android:layout_marginStart="@dimen/dp_16"
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:hint="@string/please_choose"
        android:maxLines="1"
        android:text=""
        android:textColor="@color/text_primary"
        android:textColorHint="@color/text_tertiary"
        android:textSize="@dimen/sp_15"
        app:layout_constraintEnd_toStartOf="@id/tvCity"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tvCity"
        android:layout_width="0dp"
        android:layout_height="@dimen/dp_44"
        android:layout_marginStart="@dimen/dp_4"
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:hint="@string/please_choose"
        android:maxLines="1"
        android:textColor="@color/text_primary"
        android:textColorHint="@color/text_tertiary"
        android:textSize="@dimen/sp_15"
        app:layout_constraintEnd_toStartOf="@id/tvArea"
        app:layout_constraintStart_toEndOf="@id/tvProvince"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tvArea"
        android:layout_width="0dp"
        android:layout_height="@dimen/dp_44"
        android:layout_marginStart="@dimen/dp_4"
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:hint="@string/please_choose"
        android:maxLines="1"
        android:textColor="@color/text_primary"
        android:textColorHint="@color/text_tertiary"
        android:textSize="@dimen/sp_15"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/tvCity"
        app:layout_constraintTop_toTopOf="parent" />


    <com.vaycore.finance.ui.views.StyledTextView
        android:id="@+id/tvOk"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_48"
        android:layout_marginHorizontal="@dimen/dp_30"
        android:layout_marginBottom="@dimen/dp_20"
        style="@style/mainButton"
        android:text="@string/next"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/rvAddress" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvAddress"
        android:layout_width="0dp"
        android:layout_height="@dimen/dp_300"
        android:clipToPadding="false"
        android:overScrollMode="never"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        app:layout_constraintEnd_toStartOf="@id/alphabetIndex"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvProvince" />

    <com.vaycore.finance.ui.views.AlphabetIndexView
        android:id="@+id/alphabetIndex"
        android:layout_width="@dimen/dp_24"
        android:layout_height="0dp"
        android:layout_marginEnd="@dimen/dp_8"
        app:layout_constraintBottom_toBottomOf="@id/rvAddress"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/rvAddress" />
</com.vaycore.finance.ui.views.StyledConstraintLayout>
